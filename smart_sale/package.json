{
  "name": "smart_sale",
  "version": "0.1.0",
  "description": "Smart Sales POS app with barcode printing",
  "author": "Brightech Software",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export": "next export",
    "electron-dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@chakra-ui/anatomy": "^2.3.4",
    "@chakra-ui/form-control": "^2.2.0",
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^3.35.0",
    "@chakra-ui/system": "^2.6.2",
    "@chakra-ui/table": "^2.1.0",
    "@chakra-ui/theme-tools": "^2.2.6",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@handsontable/react": "^16.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@mui/material": "^7.3.6",
    "@tanstack/react-query": "^5.90.12",
    "animate.css": "^4.1.1",
    "axios": "^1.13.2",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.38.0",
    "handsontable": "^17.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "lodash": "^4.17.23",
    "lucide-react": "^0.561.0",
    "next": "16.0.7",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.68.0",
    "react-icons": "^5.5.0",
    "react-rnd": "^10.5.3",
    "react-spreadsheet": "^0.10.1",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "yup": "^1.7.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.30.0",
    "@tailwindcss/postcss": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.smart_sale.pos",
    "asar": true,
    "files": [
      "out/**/*",
      "main.js",
      "package.json",
      "public/**/*"
    ],
    "asarUnpack": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "forceCodeSigning": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "extraMetadata": {
      "main": "main.js"
    }
  }
}
